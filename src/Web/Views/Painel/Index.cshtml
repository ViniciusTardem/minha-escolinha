@model PainelViewModel
@{
    ViewData["Title"] = "Painel";
    ViewData["ModuloAtivo"] = "painel";
    var feitos = Model.Passos.Count(p => p.Feito);
}

<div class="kt-container-fixed">
    <cabecalho-pagina titulo="@Model.NomeEscolinha" descricao="O que já está configurado na escolinha e o que chega nas próximas entregas do piloto."
                      meta="@($"Você atua como: {Model.Papeis}")"></cabecalho-pagina>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-5 lg:gap-7.5">
        <div class="xl:col-span-2 flex flex-col gap-5 lg:gap-7.5">
            @if (Model.VeConfiguracao)
            {
                <div class="kt-card">
                    <div class="kt-card-header">
                        <h3 class="kt-card-title">Configuração da escolinha</h3>
                        <span class="text-sm text-secondary-foreground">@feitos de @Model.Passos.Count concluídos</span>
                    </div>
                    <ul class="esc-linhas">
                        @foreach (var passo in Model.Passos)
                        {
                            <li class="esc-passo-config @(passo.Feito ? "esc-passo-config-feito" : null)">
                                <span class="esc-passo-config-icone">
                                    <i class="ki-filled @(passo.Feito ? "ki-check" : passo.Icone)"></i>
                                </span>
                                <span class="esc-passo-config-texto">
                                    <span class="text-sm font-semibold text-mono">@passo.Titulo</span>
                                    <span class="text-sm text-secondary-foreground">@passo.Descricao</span>
                                </span>
                                <a class="kt-btn kt-btn-sm kt-btn-outline esc-passo-config-acao" href="@passo.Url">@passo.Acao</a>
                            </li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div class="kt-card">
                    <estado-vazio icone="ki-cup" titulo="Bem-vindo à Minha Escolinha"
                                  texto="A chamada na quadra e os jogos do fim de semana chegam nas próximas entregas do piloto. Por enquanto, nada para fazer aqui."></estado-vazio>
                </div>
            }
        </div>

        <div class="kt-card">
            <div class="kt-card-header">
                <h3 class="kt-card-title">Próximas entregas</h3>
            </div>
            <div class="kt-card-content">
                @if (Model.ProximasEntregas.Count == 0)
                {
                    <p class="text-sm text-secondary-foreground">Nada novo para o seu papel.</p>
                }
                else
                {
                    <ul class="flex flex-col gap-3.5">
                        @foreach (var m in Model.ProximasEntregas)
                        {
                            <li>
                                <a class="flex items-start gap-3 group" href="@m.Url">
                                    <i class="ki-filled @m.Icone text-lg text-primary mt-0.5"></i>
                                    <span class="flex flex-col gap-0.5 min-w-0">
                                        <span class="flex items-center gap-2">
                                            <span class="text-sm font-medium text-mono group-hover:text-primary">@m.Titulo</span>
                                            <span class="kt-badge kt-badge-sm kt-badge-outline">@m.Fatia</span>
                                        </span>
                                        <span class="text-xs text-secondary-foreground">@m.Resumo</span>
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
