@using MinhaEscolinha.Application.Comum
@inject IContextoEscolinha Contexto
@model InicioPortal
@{
    ViewData["Title"] = "Início";
    Layout = "_LayoutPortal";
    var outroPapel = Contexto.Papeis.Any(p => p != PapelAtuacao.Responsavel);
}

@* A home do portal (CA-15): os filhos numa conta só, o que espera a família (convocações e mensalidades), os avisos e,
   em cada filho, as turmas e as presenças dos últimos 30 dias. *@
@section Filhos {
    <partial name="_FilhosPortal" model="Model.Filhos" />
}

<div class="flex flex-col gap-1">
    <h1 class="text-lg font-semibold text-mono">Olá, @EmissorGatilhos.PrimeiroNome(Model.Nome)!</h1>
    <p class="text-sm text-secondary-foreground">Jogos, mensalidades, presenças e avisos num lugar só. Os avisos também chegam pelo WhatsApp.</p>
</div>

@if (Model.ConvocacoesAResponder > 0)
{
    <a class="kt-card hover:border-primary" href="/Portal/Jogos">
        <span class="kt-card-content flex items-center justify-between gap-3">
            <span class="flex items-center gap-2 text-sm font-medium text-mono">
                <i class="ki-filled ki-cup text-primary"></i>
                @(Model.ConvocacoesAResponder == 1 ? "1 convocação espera a sua resposta" : $"{Model.ConvocacoesAResponder} convocações esperam a sua resposta")
            </span>
            <i class="ki-filled ki-right text-muted-foreground"></i>
        </span>
    </a>
}

@if (Model.MensalidadesEmAberto > 0)
{
    <a class="kt-card hover:border-primary" href="/Portal/Pagamentos">
        <span class="kt-card-content flex items-center justify-between gap-3">
            <span class="flex items-center gap-2 text-sm font-medium text-mono">
                <i class="ki-filled ki-dollar text-primary"></i>
                @(Model.MensalidadesEmAberto == 1 ? "1 mensalidade em aberto" : $"{Model.MensalidadesEmAberto} mensalidades em aberto"): @Formatacao.Moeda(Model.EmAberto)
            </span>
            <i class="ki-filled ki-right text-muted-foreground"></i>
        </span>
    </a>
}

@if (Model.AvisosNaoLidos > 0)
{
    <a class="kt-card hover:border-primary" href="/Portal/Avisos">
        <span class="kt-card-content flex items-center justify-between gap-3">
            <span class="flex items-center gap-2 text-sm font-medium text-mono"><i class="ki-filled ki-notification-status text-primary"></i> @Model.AvisosNaoLidos aviso(s) novo(s)</span>
            <i class="ki-filled ki-right text-muted-foreground"></i>
        </span>
    </a>
}

@if (Model.VinculosAConfirmar > 0)
{
    <div class="kt-alert kt-alert-light kt-alert-info flex items-start gap-3" role="status">
        <i class="ki-filled ki-information-2 text-lg shrink-0"></i>
        <span class="text-sm">
            A escolinha está confirmando @(Model.VinculosAConfirmar == 1 ? "o seu vínculo com 1 aluno" : $"os seus vínculos com {Model.VinculosAConfirmar} alunos").
            Por segurança, os dados aparecem aqui depois da confirmação. Os avisos pelo WhatsApp continuam normalmente.
        </span>
    </div>
}

@if (Model.Filhos.Count == 0 && Model.VinculosAConfirmar == 0)
{
    <div class="kt-card">
        <estado-vazio icone="ki-people" titulo="Nenhum aluno por aqui" texto="Se você é responsável por um aluno da escolinha, fale com a escolinha para conferir o seu cadastro."></estado-vazio>
    </div>
}

@foreach (var f in Model.Filhos)
{
    var frequencia = Model.Frequencias.GetValueOrDefault(f.AlunoId);
    <div class="kt-card">
        <div class="kt-card-content flex flex-col gap-2">
            <div class="flex items-center justify-between gap-2">
                <span class="text-lg font-semibold text-mono">@f.Nome</span>
                <selo-status valor="f.Situacao"></selo-status>
            </div>
            <span class="text-sm text-secondary-foreground flex items-center gap-1.5">
                <i class="ki-filled ki-category"></i> @(f.Turmas.Count == 0 ? "Sem turma no momento" : string.Join(", ", f.Turmas))
            </span>
            <span class="text-sm text-secondary-foreground flex items-center gap-1.5">
                <i class="ki-filled ki-check-squared"></i>
                @if (frequencia is { Marcadas: > 0 } q)
                {
                    <span>Últimos 30 dias: @q.Presencas presença(s), @q.Faltas falta(s)@(q.Justificadas > 0 ? $", {q.Justificadas} justificada(s)" : "")</span>
                }
                else
                {
                    <span>Nenhuma chamada nos últimos 30 dias</span>
                }
            </span>
            @if (Model.Resumos?.GetValueOrDefault(f.AlunoId) is { } r)
            {
                @* BL-M10-02: a visão única do filho, sem trocar de tela. *@
                <span class="text-sm text-secondary-foreground flex items-center gap-1.5">
                    <i class="ki-filled ki-calendar"></i>
                    @(r.ProximoTreino is { } treino ? $"Próximo treino: {Formatacao.DiaCurto(DateOnly.FromDateTime(treino))}, {treino:HH:mm}" : "Nenhum treino previsto")
                </span>
                @if (r.ProximoJogo is not null && r.ProximoJogoEm is { } jogoEm)
                {
                    <a class="text-sm flex flex-wrap items-center gap-1.5" href="/Portal/Jogos">
                        <i class="ki-filled ki-cup text-secondary-foreground"></i>
                        <span>@r.ProximoJogo, @Formatacao.DiaCurto(DateOnly.FromDateTime(jogoEm)) às @jogoEm.ToString("HH:mm")</span>
                        @if (r.Resposta is { } resposta)
                        {
                            <selo-status valor="resposta"></selo-status>
                        }
                    </a>
                }
                @if (r.EmAberto is > 0 && r.ProximoVencimento is { } vence)
                {
                    <a class="text-sm flex items-center gap-1.5" href="/Portal/Pagamentos">
                        <i class="ki-filled ki-dollar text-secondary-foreground"></i>
                        <span>Em aberto: @Formatacao.Moeda(r.EmAberto.Value), vence @Formatacao.Data(vence)</span>
                    </a>
                }
            }
            <a class="kt-link text-sm self-start" href="/Portal/Presencas/@f.AlunoId">Ver as presenças</a>
        </div>
    </div>
}

<div class="flex flex-col gap-2.5 pb-4">
    <partial name="_TrocaEscolinha" />
    @if (outroPapel)
    {
        <a class="kt-btn kt-btn-outline justify-center" href="/"><i class="ki-filled ki-element-11"></i> Painel da escolinha</a>
    }
    <form method="post" asp-controller="Conta" asp-action="Sair">
        <button class="kt-btn kt-btn-ghost w-full justify-center" type="submit"><i class="ki-filled ki-exit-right"></i> Sair</button>
    </form>
</div>
