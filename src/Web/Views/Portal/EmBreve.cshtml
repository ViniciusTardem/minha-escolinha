@model string
@{
    var jogos = Model == "jogos";
    ViewData["Title"] = jogos ? "Jogos" : "Pagamentos";
    Layout = "_LayoutPortal";
}

<div class="kt-card">
    <estado-vazio icone="@(jogos ? "ki-cup" : "ki-dollar")" titulo="@(jogos ? "Jogos: em breve" : "Pagamentos: em breve")"
                  texto="@(jogos ? "Aqui você vai ver os jogos e confirmar a presença de cada filho. Por enquanto, a convocação chega pelo WhatsApp." : "Aqui você vai ver as mensalidades, o total do mês e o Pix para pagar. Por enquanto, fale com a escolinha.")">
        <a class="kt-btn kt-btn-outline" href="/Portal"><i class="ki-filled ki-home-2"></i> Voltar ao início</a>
    </estado-vazio>
</div>
