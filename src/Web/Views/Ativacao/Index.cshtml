@model AtivacaoViewModel
@{
    ViewData["Title"] = "Ativar o acesso";
    Layout = "_LayoutAutenticacao";
}

<div class="kt-card max-w-[420px] w-full">
    @if (Model.Estado != EstadoConvite.Valido)
    {
        <div class="kt-card-content flex flex-col items-center gap-4 p-8 sm:p-10 text-center">
            <i class="ki-filled ki-key text-4xl text-muted-foreground"></i>
            <h1 class="text-lg font-medium text-mono">Convite indisponível</h1>
            <p class="text-sm text-secondary-foreground">@ServicoAtivacaoConvite.MensagemEstado(Model.Estado)</p>
            <a class="kt-btn kt-btn-outline" asp-controller="Conta" asp-action="Login">Ir para o login</a>
        </div>
    }
    else
    {
        <form method="post" asp-controller="Ativacao" asp-action="Identificar" asp-route-token="@Model.Token" class="kt-card-content flex flex-col gap-5 p-8 sm:p-10" novalidate>
            <div class="text-center mb-2.5">
                <h1 class="text-lg font-medium text-mono leading-none mb-2.5">Ativar o acesso</h1>
                <p class="text-sm text-secondary-foreground">Para a sua segurança, confirme quem você é: informe o seu CPF, o mesmo que está no cadastro da escolinha.</p>
            </div>

            <partial name="_ErrosFormulario" />

            <div class="flex flex-col gap-1">
                <label class="kt-form-label font-normal text-mono" for="Cpf">CPF</label>
                <input class="kt-input" id="Cpf" name="Cpf" value="@Model.Cpf.Cpf" inputmode="numeric" autocomplete="off" maxlength="14"
                       placeholder="000.000.000-00" required autofocus
                       aria-invalid="@(ViewData.ModelState["Cpf"]?.Errors.Count > 0 ? "true" : null)" />
            </div>

            <button class="kt-btn kt-btn-primary flex justify-center grow" type="submit">Continuar</button>
            <p class="text-xs text-muted-foreground text-center">Nenhum dado aparece antes de o CPF ser conferido. O link vale só para você e só uma vez.</p>
        </form>
    }
</div>
