@model ConvitesViewModel
@{
    ViewData["Title"] = "Convites de acesso";
    var voltar = Context.Request.Path + Context.Request.QueryString;
    var contagem = new (SituacaoAcesso Situacao, string Rotulo)[]
    {
        (SituacaoAcesso.Ativo, "Com acesso"), (SituacaoAcesso.Convidado, "Convidados"),
        (SituacaoAcesso.ConviteExpirado, "Convite vencido"), (SituacaoAcesso.SemAcesso, "Sem acesso")
    };
    var tipos = new (string? Valor, string Rotulo)[] { (null, "Todos"), ("responsaveis", "Responsáveis"), ("professores", "Professores") };
    bool Convidavel(CandidatoAcesso c) => c.Situacao is SituacaoAcesso.SemAcesso or SituacaoAcesso.ConviteExpirado && c.Telefone is not null;
    var convidaveis = Model.Lista.Count(Convidavel);
}

<div class="kt-container-fixed">
    <cabecalho-pagina titulo="Convites de acesso" meta="@($"{Model.Todos.Count(c => c.Situacao == SituacaoAcesso.Ativo)} de {Model.Todos.Count} com acesso")"
                      descricao="O convite vai pelo WhatsApp com um link de uso único (vale 7 dias). A pessoa confere o CPF e cria a senha. Quem ainda não ativou continua recebendo tudo pelo WhatsApp.">
        @if (Model.VinculosAConfirmar > 0)
        {
            <a class="kt-btn kt-btn-primary" href="/Vinculos"><i class="ki-filled ki-user-tick"></i> Vínculos a confirmar (@Model.VinculosAConfirmar)</a>
        }
    </cabecalho-pagina>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-5 mb-5">
        @foreach (var (situacao, rotulo) in contagem)
        {
            <a class="kt-card hover:border-primary" href="?situacao=@situacao@(Model.Tipo is null ? "" : $"&tipo={Model.Tipo}")">
                <span class="kt-card-content flex flex-col gap-1">
                    <span class="text-xs text-secondary-foreground">@rotulo</span>
                    <span class="text-3xl font-semibold text-mono">@Model.Todos.Count(c => c.Situacao == situacao)</span>
                </span>
            </a>
        }
    </div>

    <form method="get" class="kt-card mb-5">
        <div class="kt-card-content grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
            <div class="flex flex-col gap-1 md:col-span-2">
                <label class="kt-form-label" for="busca">Buscar</label>
                <div class="kt-input">
                    <i class="ki-filled ki-magnifier"></i>
                    <input id="busca" name="busca" type="search" value="@Model.Busca" placeholder="Nome" />
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <label class="kt-form-label" for="tipo">Quem</label>
                <select class="kt-select" id="tipo" name="tipo" data-esc-enviar-ao-mudar>
                    @foreach (var (valor, rotulo) in tipos)
                    {
                        <option value="@valor" selected="@(valor == Model.Tipo)">@rotulo</option>
                    }
                </select>
            </div>
            <div class="flex flex-col gap-1">
                <label class="kt-form-label" for="situacao">Acesso</label>
                <select class="kt-select" id="situacao" name="situacao" data-esc-enviar-ao-mudar>
                    <option value="">Todos</option>
                    @foreach (var (situacao, rotulo) in contagem)
                    {
                        <option value="@situacao" selected="@(situacao == Model.Situacao)">@rotulo</option>
                    }
                </select>
            </div>
        </div>
    </form>

    <div class="kt-card">
        @if (Model.PodeConvidar && convidaveis > 0)
        {
            <div class="kt-card-header flex-wrap gap-3 py-4">
                <h3 class="kt-card-title">Convidar em lote</h3>
                <form id="form-lote" method="post" asp-action="Lote" class="flex flex-wrap items-center gap-2.5"
                      data-esc-confirmar="Mandar um convite pelo WhatsApp para cada pessoa marcada?">
                    <input type="hidden" name="voltar" value="@voltar" />
                    <span class="text-xs text-secondary-foreground">Marque na lista quem vai receber (@convidaveis sem acesso nesta lista).</span>
                    <button class="kt-btn kt-btn-primary" type="submit"><i class="ki-filled ki-whatsapp"></i> Convidar marcados</button>
                </form>
            </div>
        }
        @if (Model.Lista.Count == 0)
        {
            <estado-vazio icone="ki-key" titulo="Ninguém nesta lista" texto="Mude a busca ou os filtros. Responsáveis e professores entram aqui quando são cadastrados."></estado-vazio>
        }
        else
        {
            <div class="kt-card-table kt-scrollable-x-auto">
                <table class="kt-table kt-table-border align-middle text-sm">
                    <thead>
                        <tr>
                            @if (Model.PodeConvidar && convidaveis > 0)
                            {
                                <th class="w-[1%]"><span class="sr-only">Marcar</span></th>
                            }
                            <th class="min-w-[120px] sm:min-w-[220px]">Pessoa</th>
                            <th class="min-w-[140px] hidden md:table-cell">Celular</th>
                            <th class="min-w-[170px] hidden sm:table-cell">Acesso</th>
                            <th class="w-[1%] text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Lista)
                        {
                            var ficha = c.Tipo == TipoConvite.Responsavel ? $"/Responsaveis/Ficha/{c.FichaId}" : $"/Professores/Ficha/{c.FichaId}";
                            <tr>
                                @if (Model.PodeConvidar && convidaveis > 0)
                                {
                                    <td>
                                        @if (Convidavel(c))
                                        {
                                            <input class="kt-checkbox kt-checkbox-sm" type="checkbox" form="form-lote" name="selecionados"
                                                   value="@((int)c.Tipo):@c.FichaId" aria-label="@($"Convidar {c.Nome}")" />
                                        }
                                    </td>
                                }
                                <td>
                                    <div class="flex flex-col gap-0.5">
                                        <a class="font-medium text-mono hover:text-primary" href="@ficha">@c.Nome</a>
                                        <span class="text-xs text-secondary-foreground">@(c.Tipo == TipoConvite.Professor ? "Professor" : "Responsável")@(c.Detalhe is null ? "" : $" · {c.Detalhe}")</span>
                                        @* No celular, o acesso desce para cá e as ações ficam só com o ícone: nada escondido à direita. *@
                                        <span class="flex flex-wrap items-center gap-1.5 sm:hidden">
                                            <selo-status valor="c.Situacao"></selo-status>
                                            @if (c.Situacao == SituacaoAcesso.Convidado && c.ExpiraEm is { } expiraCelular)
                                            {
                                                <span class="text-xs text-secondary-foreground">até @Formatacao.Data(expiraCelular)</span>
                                            }
                                        </span>
                                    </div>
                                </td>
                                <td class="hidden md:table-cell text-secondary-foreground">@(c.Telefone is null ? "sem celular" : Formatacao.Telefone(c.Telefone))</td>
                                <td class="hidden sm:table-cell">
                                    <div class="flex flex-col gap-1">
                                        <selo-status class="self-start" valor="c.Situacao"></selo-status>
                                        @if (c.Situacao == SituacaoAcesso.Convidado && c.ExpiraEm is { } expira)
                                        {
                                            <span class="text-xs text-secondary-foreground">Vale até @Formatacao.Data(expira)</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end">
                                    @if (Model.PodeConvidar)
                                    {
                                        <div class="flex justify-end gap-2">
                                            @if (Convidavel(c))
                                            {
                                                <form method="post" asp-action="Convidar" asp-route-tipo="@c.Tipo" asp-route-id="@c.FichaId">
                                                    <input type="hidden" name="voltar" value="@voltar" />
                                                    <button class="kt-btn kt-btn-sm kt-btn-outline" type="submit" aria-label="@($"Convidar {c.Nome} pelo WhatsApp")"><i class="ki-filled ki-whatsapp"></i> <span class="hidden sm:inline">@(c.Situacao == SituacaoAcesso.ConviteExpirado ? "Convidar de novo" : "Convidar")</span></button>
                                                </form>
                                            }
                                            else if (c.Situacao == SituacaoAcesso.Convidado && c.ConviteId is { } convite)
                                            {
                                                <form method="post" asp-action="Reenviar" asp-route-id="@convite" data-esc-confirmar="@($"Reenviar o convite para {c.Nome}? O link anterior deixa de valer.")">
                                                    <input type="hidden" name="voltar" value="@voltar" />
                                                    <button class="kt-btn kt-btn-sm kt-btn-outline" type="submit" aria-label="@($"Reenviar o convite para {c.Nome}")"><i class="ki-filled ki-arrows-circle"></i> <span class="hidden sm:inline">Reenviar</span></button>
                                                </form>
                                                <form method="post" asp-action="Cancelar" asp-route-id="@convite" data-esc-confirmar="@($"Cancelar o convite de {c.Nome}? O link deixa de valer.")">
                                                    <input type="hidden" name="voltar" value="@voltar" />
                                                    <button class="kt-btn kt-btn-sm kt-btn-ghost" type="submit" aria-label="@($"Cancelar o convite de {c.Nome}")"><i class="ki-filled ki-cross-circle"></i></button>
                                                </form>
                                            }
                                            else if (c.Telefone is null && c.Situacao != SituacaoAcesso.Ativo)
                                            {
                                                <a class="kt-btn kt-btn-sm kt-btn-ghost" href="@ficha" aria-label="@($"Cadastrar o celular de {c.Nome}")"><i class="ki-filled ki-phone"></i> <span class="hidden sm:inline">Cadastrar celular</span></a>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
