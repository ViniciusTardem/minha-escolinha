@model MensalidadeMatriculaRequisicao
@{
    var (matricula, aluno) = ((MinhaEscolinha.Domain.Alunos.Matricula, string))ViewData["Matricula"]!;
    ViewData["Title"] = $"Mensalidade · {aluno}";
    var mensalidade = ViewData.ModelState[nameof(Model.Mensalidade)]?.AttemptedValue ?? Moeda.ParaCampo(Model.Mensalidade);
}

<div class="kt-container-fixed">
    <cabecalho-pagina titulo="Mensalidade da matrícula" meta="@($"{aluno} · {matricula.Turma?.Nome}")" voltar-href="/Alunos/Ficha/@matricula.Aluno_ID?aba=matriculas"
                      voltar-texto="Ficha do aluno"
                      descricao="Valor próprio desta matrícula (desconto, bolsa, irmão). Mudar a mensalidade fica registrado com autor, data e o valor anterior."></cabecalho-pagina>

    <div class="kt-card max-w-[640px]">
        <form asp-action="Mensalidade" asp-route-id="@matricula.Matricula_ID" method="post" novalidate>
            <div class="kt-card-content flex flex-col gap-5">
                <partial name="_ErrosFormulario" />
                <div class="flex flex-col gap-1 max-w-[260px]">
                    <label class="kt-form-label" asp-for="Mensalidade">Mensalidade</label>
                    <div class="kt-input-group">
                        <span class="kt-input-addon">R$</span>
                        <input class="kt-input" asp-for="Mensalidade" type="text" inputmode="decimal" value="@mensalidade" required />
                    </div>
                    <span class="text-xs text-muted-foreground">A da turma é @(matricula.Turma is null ? "—" : Formatacao.Moeda(matricula.Turma.Mensalidade)).</span>
                </div>
                <div class="flex flex-col gap-1">
                    <label class="kt-form-label" asp-for="Motivo">Motivo <span class="text-muted-foreground">(recomendado)</span></label>
                    <input class="kt-input" asp-for="Motivo" maxlength="300" placeholder="Ex.: desconto de irmão" />
                </div>
            </div>
            <div class="kt-card-footer justify-end gap-2.5">
                <a class="kt-btn kt-btn-ghost me-auto" href="/Alunos/Ficha/@matricula.Aluno_ID?aba=matriculas">Cancelar</a>
                <button class="kt-btn kt-btn-primary" type="submit"><i class="ki-filled ki-check"></i> Salvar</button>
            </div>
        </form>
    </div>
</div>
