@model TemplateRequisicao
@{
    ViewData["Title"] = "Editar template";
    var info = ViewData["Info"] as TemplateNaLista;
    var regra = info is null ? null : CatalogoGatilhos.Obter(info.Gatilho);
}

<div class="kt-container-fixed">
    <cabecalho-pagina titulo="@(regra?.Nome ?? "Template")" voltar-href="/Templates" voltar-texto="Templates"
                      descricao="Mudou o texto de um template aprovado? Troque o nome na Meta (a versão, _v2) e volte para rascunho: é um template novo para aprovar.">
    </cabecalho-pagina>

    <div class="kt-card max-w-[820px]">
        <form asp-action="Editar" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <div class="kt-card-content flex flex-col gap-5">
                <partial name="_ErrosFormulario" />
                @if (info is not null)
                {
                    <dl class="esc-dados">
                        <dt>Gatilho</dt>
                        <dd>@regra!.Evento → @regra.RotuloDestinatario (@regra.Quando)</dd>
                        <dt>Tom</dt>
                        <dd>@(info.Tom == TomMensagem.Direto ? "Direto" : "Cordial")</dd>
                        <dt>Parâmetros</dt>
                        <dd>@string.Join(", ", info.Variaveis.Select((v, i) => $"{{{{{i + 1}}}}} {v}"))</dd>
                    </dl>
                }
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="NomeNaMeta">Nome na Meta</label>
                        <input class="kt-input font-mono" asp-for="NomeNaMeta" maxlength="120" required />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="Situacao">Situação na Meta</label>
                        <select class="kt-select" asp-for="Situacao">
                            @foreach (var s in Enum.GetValues<SituacaoAprovacaoTemplate>())
                            {
                                <option value="@s">@TemplateMensagem.Rotulo(s)</option>
                            }
                        </select>
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="Categoria">Categoria (política do WhatsApp)</label>
                        <select class="kt-select" asp-for="Categoria">
                            @foreach (var c in Enum.GetValues<CategoriaTemplate>())
                            {
                                <option value="@c">@TemplateMensagem.Rotulo(c)</option>
                            }
                        </select>
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="Botoes">Botões de resposta <span class="text-muted-foreground">(opcional)</span></label>
                        <input class="kt-input" asp-for="Botoes" maxlength="200" placeholder="Vai|Não vai" />
                        <span class="text-xs text-muted-foreground">Até 3, separados por |. O sistema entende a resposta pela posição do botão.</span>
                    </div>
                    <div class="flex flex-col gap-1 md:col-span-2">
                        <label class="kt-form-label" asp-for="Corpo">Texto</label>
                        <textarea class="kt-textarea" asp-for="Corpo" rows="5" maxlength="1024" required></textarea>
                        <span class="text-xs text-muted-foreground">Use {{1}}, {{2}}... na ordem dos parâmetros, cada um uma vez. Não comece nem termine com um parâmetro.</span>
                    </div>
                    <div class="flex flex-col gap-1 md:col-span-2">
                        <label class="kt-form-label" asp-for="Observacao">Nota <span class="text-muted-foreground">(opcional)</span></label>
                        <input class="kt-input" asp-for="Observacao" maxlength="500" placeholder="Motivo da rejeição da Meta, data da submissão..." />
                    </div>
                </div>
            </div>
            <div class="kt-card-footer justify-end gap-2.5">
                <a class="kt-btn kt-btn-ghost me-auto" asp-action="Index">Cancelar</a>
                <button class="kt-btn kt-btn-primary" type="submit"><i class="ki-filled ki-check"></i> Salvar</button>
            </div>
        </form>
    </div>
</div>
