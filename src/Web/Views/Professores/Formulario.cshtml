@model ProfessorRequisicao
@{
    var novo = Model.Id is null;
    ViewData["Title"] = novo ? "Novo professor" : $"Editar {Model.Nome}";
    var candidatos = ViewData["Candidatos"] as IReadOnlyList<CandidatoProfessor> ?? [];
    var reaproveitando = Model.Origem != OrigemCadastroProfessor.PessoaNova;
    var cpfTravado = Model.Origem == OrigemCadastroProfessor.PessoaComAcesso && !string.IsNullOrEmpty(Model.Cpf);
}

<div class="kt-container-fixed">
    <cabecalho-pagina titulo="@(novo ? "Novo professor" : Model.Nome)" voltar-href="@(novo ? "/Professores" : $"/Professores/Ficha/{Model.Id}")"
                      voltar-texto="@(novo ? "Professores" : "Ficha do professor")"
                      descricao="Dados pessoais e contato. O celular é por onde chega o convite de acesso ao sistema."></cabecalho-pagina>

    @if (novo && candidatos.Count > 0 && !reaproveitando)
    {
        <div class="kt-card max-w-[820px] mb-5">
            <div class="kt-card-header">
                <h3 class="kt-card-title">Já está na escolinha?</h3>
            </div>
            <form method="get" asp-action="Novo" class="kt-card-content flex flex-col gap-3">
                <p class="text-sm text-secondary-foreground">
                    O gestor que também dá aula, ou um pai ou mãe que ajuda no treino: use o cadastro que já existe, sem digitar de novo.
                </p>
                <div class="flex flex-col sm:flex-row gap-3">
                    <div class="flex flex-col gap-1 grow min-w-0">
                        <label class="kt-form-label" for="candidato">Pessoa</label>
                        <select class="kt-select" id="candidato" name="candidato" data-esc-selecao-busca data-esc-busca-placeholder="Buscar pelo nome…">
                            <option value="">Selecione</option>
                            @foreach (var c in candidatos)
                            {
                                <option value="@((int)c.Origem)|@c.Id">@c.Nome — @c.Detalhe</option>
                            }
                        </select>
                    </div>
                    <div class="flex items-end">
                        <button class="kt-btn kt-btn-outline w-full sm:w-auto justify-center" type="submit"><i class="ki-filled ki-user-tick"></i> Usar este cadastro</button>
                    </div>
                </div>
            </form>
        </div>
    }

    <div class="kt-card max-w-[820px]">
        <form method="post" asp-action="@(novo ? "Novo" : "Editar")" asp-route-id="@Model.Id" novalidate>
            <input type="hidden" asp-for="Origem" />
            <input type="hidden" asp-for="OrigemId" />
            <input type="hidden" asp-for="OrigemNome" />
            <div class="kt-card-content flex flex-col gap-5">
                <partial name="_ErrosFormulario" />
                @if (reaproveitando)
                {
                    <div class="kt-alert kt-alert-light kt-alert-primary flex items-start gap-3" role="status">
                        <i class="ki-filled ki-user-tick text-lg shrink-0"></i>
                        <div class="flex flex-col gap-1 text-sm">
                            <span>Reaproveitando o cadastro de <strong>@Model.OrigemNome</strong>.</span>
                            <a class="kt-link" asp-action="Novo">Cadastrar outra pessoa</a>
                        </div>
                    </div>
                }
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="flex flex-col gap-1 md:col-span-2">
                        <label class="kt-form-label" asp-for="Nome">Nome</label>
                        <input class="kt-input" asp-for="Nome" required maxlength="150" autocomplete="name" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="Cpf">CPF <span class="text-muted-foreground">(opcional)</span></label>
                        <input class="kt-input" asp-for="Cpf" inputmode="numeric" placeholder="000.000.000-00" readonly="@cpfTravado" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="Telefone">Celular (WhatsApp)</label>
                        <input class="kt-input" asp-for="Telefone" type="tel" inputmode="tel" placeholder="(43) 99999-9999" autocomplete="tel" />
                    </div>
                    <div class="flex flex-col gap-1 md:col-span-2">
                        <label class="kt-form-label" asp-for="Email">E-mail <span class="text-muted-foreground">(opcional)</span></label>
                        <input class="kt-input" asp-for="Email" type="email" maxlength="150" autocomplete="email" />
                    </div>
                </div>
            </div>
            <div class="kt-card-footer justify-end gap-2.5">
                <a class="kt-btn kt-btn-ghost me-auto" href="@(novo ? "/Professores" : $"/Professores/Ficha/{Model.Id}")">Cancelar</a>
                <button class="kt-btn kt-btn-primary" type="submit"><i class="ki-filled ki-check"></i> Salvar</button>
            </div>
        </form>
    </div>
</div>
