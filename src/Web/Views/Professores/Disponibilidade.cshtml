@model DisponibilidadeRequisicao
@{
    var professor = ViewData["Professor"] as string ?? "Professor";
    ViewData["Title"] = $"Disponibilidade de {professor}";
}

<div class="kt-container-fixed">
    <cabecalho-pagina titulo="Disponibilidade semanal" meta="@professor" voltar-href="/Professores/Ficha/@Model.ProfessorId" voltar-texto="Ficha do professor"
                      descricao="As faixas em que o professor pode dar aula. Treino marcado fora delas gera alerta ao salvar a turma (sem bloquear). Sem nenhuma faixa, não há esse alerta."></cabecalho-pagina>

    <div class="kt-card max-w-[720px]">
        <form method="post" asp-action="Disponibilidade" asp-route-id="@Model.ProfessorId" novalidate>
            <div class="kt-card-content flex flex-col gap-4" data-esc-linhas data-esc-linhas-prefixo="Faixas">
                <partial name="_ErrosFormulario" />
                <ul class="flex flex-col gap-3" data-esc-linhas-lista>
                    @for (var i = 0; i < Model.Faixas.Count; i++)
                    {
                        <li class="esc-linha-horario" data-esc-linha>
                            <select class="kt-select" asp-for="Faixas[i].DiaSemana" aria-label="Dia da semana">
                                @foreach (var dia in DiasSemana.Ordem)
                                {
                                    <option value="@dia">@DiasSemana.Nome(dia)</option>
                                }
                            </select>
                            <input class="kt-input" asp-for="Faixas[i].Inicio" type="time" aria-label="Das" />
                            <input class="kt-input" asp-for="Faixas[i].Fim" type="time" aria-label="Até" />
                            <button class="kt-btn kt-btn-icon kt-btn-ghost" type="button" data-esc-linhas-remover hidden aria-label="Retirar faixa"><i class="ki-filled ki-trash"></i></button>
                        </li>
                    }
                </ul>
                <template data-esc-linhas-modelo>
                    <li class="esc-linha-horario" data-esc-linha>
                        <select class="kt-select" name="Faixas[__i__].DiaSemana" aria-label="Dia da semana">
                            @foreach (var dia in DiasSemana.Ordem)
                            {
                                <option value="@dia">@DiasSemana.Nome(dia)</option>
                            }
                        </select>
                        <input class="kt-input" name="Faixas[__i__].Inicio" type="time" aria-label="Das" />
                        <input class="kt-input" name="Faixas[__i__].Fim" type="time" aria-label="Até" />
                        <button class="kt-btn kt-btn-icon kt-btn-ghost" type="button" data-esc-linhas-remover aria-label="Retirar faixa"><i class="ki-filled ki-trash"></i></button>
                    </li>
                </template>
                <div>
                    <button class="kt-btn kt-btn-sm kt-btn-outline" type="button" data-esc-linhas-adicionar hidden><i class="ki-filled ki-plus"></i> Outra faixa</button>
                </div>
                <p class="text-xs text-muted-foreground">Uma linha por faixa: "Terça, 17:00 às 21:00". Linha em branco é ignorada.</p>
            </div>
            <div class="kt-card-footer justify-end gap-2.5">
                <a class="kt-btn kt-btn-ghost me-auto" href="/Professores/Ficha/@Model.ProfessorId">Cancelar</a>
                <button class="kt-btn kt-btn-primary" type="submit"><i class="ki-filled ki-check"></i> Salvar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/linhas.js" asp-append-version="true"></script>
}
