@model SaudeAlunoRequisicao
@{
    ViewData["Title"] = "Saúde do aluno";
}

<div class="kt-container-fixed">
    <cabecalho-pagina titulo="Saúde e emergência" voltar-href="/Alunos/Ficha/@Model.Id?aba=saude" voltar-texto="Ficha do aluno"
                      descricao="Dado sensível: o professor da turma vê só alergias, restrições e o contato de emergência. O registro de alterações anota que mudou, nunca o conteúdo."></cabecalho-pagina>

    <div class="kt-card max-w-[820px]">
        <form asp-action="Saude" asp-route-id="@Model.Id" method="post" novalidate>
            <input type="hidden" asp-for="Versao" />
            <div class="kt-card-content flex flex-col gap-5">
                <partial name="_ErrosFormulario" />
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="Alergias">Alergias</label>
                        <textarea class="kt-textarea" asp-for="Alergias" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="Restricoes">Restrições para o treino</label>
                        <textarea class="kt-textarea" asp-for="Restricoes" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="flex flex-col gap-1 md:col-span-2">
                        <label class="kt-form-label" asp-for="ObservacoesMedicas">Observações médicas <span class="text-muted-foreground">(só gestor e responsável)</span></label>
                        <textarea class="kt-textarea" asp-for="ObservacoesMedicas" rows="3" maxlength="1000"></textarea>
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="ContatoEmergenciaNome">Contato de emergência</label>
                        <input class="kt-input" asp-for="ContatoEmergenciaNome" maxlength="150" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="flex flex-col gap-1">
                            <label class="kt-form-label" asp-for="ContatoEmergenciaTelefone">Telefone</label>
                            <input class="kt-input" asp-for="ContatoEmergenciaTelefone" type="tel" inputmode="tel" />
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="kt-form-label" asp-for="ContatoEmergenciaParentesco">Parentesco</label>
                            <input class="kt-input" asp-for="ContatoEmergenciaParentesco" maxlength="60" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="kt-card-footer justify-end gap-2.5">
                <a class="kt-btn kt-btn-ghost me-auto" href="/Alunos/Ficha/@Model.Id?aba=saude">Cancelar</a>
                <button class="kt-btn kt-btn-primary" type="submit"><i class="ki-filled ki-check"></i> Salvar</button>
            </div>
        </form>
    </div>
</div>
