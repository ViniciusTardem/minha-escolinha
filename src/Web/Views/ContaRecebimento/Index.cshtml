@inject IAutorizacao Autorizacao
@model ContaAsaasResposta
@{
    ViewData["Title"] = "Conta de recebimento";
    var ambiente = ViewData["Ambiente"] as MinhaEscolinha.Application.Comum.IAmbienteExecucao;
}

<div class="kt-container-fixed">
    <cabecalho-pagina titulo="Conta de recebimento" descricao="A conta Asaas da escolinha: as mensalidades caem direto nela. Sem conta vinculada, nenhuma cobrança é emitida.">
        @if (Autorizacao.Pode(Recurso.FinanceiroEscolinha, Operacao.Alterar))
        {
            <a class="kt-btn kt-btn-primary" asp-action="Vincular">
                <i class="ki-filled ki-bank"></i> @(Model.Vinculada ? "Trocar conta" : "Vincular conta")
            </a>
        }
    </cabecalho-pagina>

    <div class="kt-card max-w-[720px]">
        @if (!Model.Vinculada)
        {
            <estado-vazio icone="ki-bank" titulo="Nenhuma conta vinculada"
                          texto="Cole a chave de API da conta Asaas da escolinha. Enquanto isso, as mensalidades não são emitidas."></estado-vazio>
        }
        else
        {
            <div class="kt-card-content">
                <dl class="esc-dados">
                    <dt>Situação</dt>
                    <dd><selo-status valor="SinalTela.ContaRecebimentoVinculada" texto="Vinculada"></selo-status></dd>
                    <dt>Ambiente</dt>
                    <dd><selo-status valor="Model.Ambiente"></selo-status></dd>
                    <dt>Chave de API</dt>
                    <dd class="font-mono">••••@Model.FinalChave</dd>
                    <dt>Vinculada em</dt>
                    <dd>@Formatacao.DataHora(Model.VinculadaEm)</dd>
                    <dt>Integração</dt>
                    <dd>@Model.Integracao</dd>
                    <dt>Avisos da Asaas</dt>
                    <dd class="flex flex-col gap-1">
                        @if (Model.Simulador)
                        {
                            <span>O simulador avisa direto o sistema: <a class="kt-link" href="/dev/asaas">/dev/asaas</a></span>
                        }
                        else if (Model.WebhookRegistradoEm is { } registrado)
                        {
                            <span>Webhook cadastrado na conta em @Formatacao.DataHora(registrado).</span>
                        }
                        else if (Model.WebhookErro is not null)
                        {
                            <span>A Asaas recusou o cadastro do webhook: @Model.WebhookErro</span>
                        }
                        else
                        {
                            <span>O webhook está sendo cadastrado na conta.</span>
                        }
                        @if (Model.UrlWebhook is not null && !Model.Simulador)
                        {
                            <span class="text-xs text-secondary-foreground font-mono wrap-anywhere">@Model.UrlWebhook</span>
                        }
                    </dd>
                </dl>
            </div>
        }
        <div class="kt-card-footer text-xs text-muted-foreground">
            A chave fica cifrada e nunca volta para a tela. As mensalidades são emitidas nesta conta, e a Asaas avisa o sistema quando
            uma é paga, vence ou é excluída: a conciliação é automática.
            @if (ambiente is { EhProducao: false })
            {
                <text>Este ambiente (@ambiente.Nome) só aceita conta Sandbox.</text>
            }
        </div>
    </div>
</div>
