@model ResolverDivergenciaRequisicao
@{
    var acao = (CobrancaParaAcao)ViewData["Cobranca"]!;
    var l = acao.Linha;
    ViewData["Title"] = "Resolver divergência";
    var opcoes = new List<(ResolucaoDivergencia Valor, string Rotulo, string Ajuda)>
    {
        (ResolucaoDivergencia.Ciencia, "Registrar que a gestão tratou por fora", "A situação da mensalidade fica como está; a divergência sai da fila.")
    };
    if (l.PodeAceitarPagamentoDivergente)
        opcoes.Add((ResolucaoDivergencia.AceitarComoPaga, $"Aceitar {Formatacao.Moeda(l.ValorPago!.Value)} como o pagamento da mensalidade",
            "A mensalidade fica paga com o valor que entrou, e a família recebe a confirmação."));
    if (l.PodeSerEncerrada)
    {
        // Paga e estornada: o dinheiro já voltou para a família.
        var devolvida = l.Situacao is SituacaoCobranca.Paga or SituacaoCobranca.PagaEmAtraso;
        opcoes.Add((ResolucaoDivergencia.Cancelar, "Cancelar a mensalidade", devolvida
            ? "O dinheiro voltou para a família: a mensalidade sai das pagas e não é cobrada de novo."
            : "Deixa de ser cobrada. Na Asaas, trate a fatura pelo painel dela."));
        opcoes.Add((ResolucaoDivergencia.Isentar, "Isentar a mensalidade", devolvida
            ? "O dinheiro voltou para a família: a mensalidade sai das pagas e fica isenta."
            : "Não é cobrada nem entra na inadimplência."));
    }
}

<div class="kt-container-fixed">
    <cabecalho-pagina titulo="Resolver divergência" meta="@($"{l.Aluno} · {Formatacao.Mes(l.Competencia)}")"
                      voltar-href="/Mensalidades/Divergencias" voltar-texto="Divergências"
                      descricao="Nada muda sozinho numa divergência: a gestão decide, com uma explicação que fica no histórico da mensalidade, com o autor e a data."></cabecalho-pagina>

    <div class="kt-card max-w-[640px]">
        <form method="post" asp-action="Resolver" novalidate>
            <input type="hidden" asp-for="Id" />
            <div class="kt-card-content flex flex-col gap-5">
                <partial name="_ErrosFormulario" />
                <partial name="_ResumoMensalidade" model="l" />
                <fieldset class="flex flex-col gap-3">
                    <legend class="kt-form-label mb-2">Como resolver</legend>
                    @foreach (var (valor, rotulo, ajuda) in opcoes)
                    {
                        <label class="flex items-start gap-2.5">
                            <input class="kt-radio mt-0.5" type="radio" name="Resolucao" value="@valor" checked="@(valor == Model.Resolucao)" />
                            <span class="flex flex-col gap-0.5">
                                <span class="text-sm font-medium text-mono">@rotulo</span>
                                <span class="text-xs text-secondary-foreground">@ajuda</span>
                            </span>
                        </label>
                    }
                </fieldset>
                <div class="flex flex-col gap-1">
                    <label class="kt-form-label" asp-for="Explicacao">Explicação</label>
                    <textarea class="kt-textarea" asp-for="Explicacao" rows="2" maxlength="300" required placeholder="Ex.: a família pagou a diferença em dinheiro"></textarea>
                </div>
            </div>
            <div class="kt-card-footer justify-end gap-2.5">
                <a class="kt-btn kt-btn-ghost me-auto" href="/Mensalidades/Divergencias">Voltar</a>
                <button class="kt-btn kt-btn-primary" type="submit"><i class="ki-filled ki-check"></i> Resolver</button>
            </div>
        </form>
    </div>
</div>
