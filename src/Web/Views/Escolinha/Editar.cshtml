@model DadosEscolinhaRequisicao
@{
    ViewData["Title"] = "Editar dados da escolinha";
}

<div class="kt-container-fixed">
    <cabecalho-pagina titulo="Editar dados da escolinha" voltar-href="/Escolinha" voltar-texto="Dados da escolinha"
                      descricao="Cada campo alterado fica na trilha de auditoria com o valor anterior."></cabecalho-pagina>

    <div class="kt-card max-w-[820px]">
        <form asp-action="Editar" method="post" novalidate>
            <div class="kt-card-content flex flex-col gap-5">
                <partial name="_ErrosFormulario" />
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="flex flex-col gap-1 md:col-span-2">
                        <label class="kt-form-label" asp-for="Nome">Nome da escolinha</label>
                        <input class="kt-input" asp-for="Nome" required maxlength="150" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="RazaoSocial">Razão social</label>
                        <input class="kt-input" asp-for="RazaoSocial" maxlength="200" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="Cnpj">CNPJ</label>
                        <input class="kt-input" asp-for="Cnpj" inputmode="numeric" placeholder="00.000.000/0000-00" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="Telefone">Telefone</label>
                        <input class="kt-input" asp-for="Telefone" type="tel" inputmode="tel" placeholder="(43) 99999-9999" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="Email">E-mail</label>
                        <input class="kt-input" asp-for="Email" type="email" />
                    </div>
                </div>

                <div class="border-t border-border"></div>

                <div class="grid grid-cols-1 md:grid-cols-6 gap-5">
                    <div class="flex flex-col gap-1 md:col-span-4">
                        <label class="kt-form-label" asp-for="Logradouro">Logradouro</label>
                        <input class="kt-input" asp-for="Logradouro" maxlength="150" />
                    </div>
                    <div class="flex flex-col gap-1 md:col-span-2">
                        <label class="kt-form-label" asp-for="Numero">Número</label>
                        <input class="kt-input" asp-for="Numero" maxlength="20" />
                    </div>
                    <div class="flex flex-col gap-1 md:col-span-3">
                        <label class="kt-form-label" asp-for="Complemento">Complemento</label>
                        <input class="kt-input" asp-for="Complemento" maxlength="80" />
                    </div>
                    <div class="flex flex-col gap-1 md:col-span-3">
                        <label class="kt-form-label" asp-for="Bairro">Bairro</label>
                        <input class="kt-input" asp-for="Bairro" maxlength="80" />
                    </div>
                    <div class="flex flex-col gap-1 md:col-span-3">
                        <label class="kt-form-label" asp-for="Cidade">Cidade</label>
                        <input class="kt-input" asp-for="Cidade" maxlength="80" />
                    </div>
                    <div class="flex flex-col gap-1 md:col-span-1">
                        <label class="kt-form-label" asp-for="Uf">UF</label>
                        <input class="kt-input" asp-for="Uf" maxlength="2" />
                    </div>
                    <div class="flex flex-col gap-1 md:col-span-2">
                        <label class="kt-form-label" asp-for="Cep">CEP</label>
                        <input class="kt-input" asp-for="Cep" inputmode="numeric" placeholder="00000-000" />
                    </div>
                </div>
            </div>
            <div class="kt-card-footer justify-end gap-2.5">
                <a class="kt-btn kt-btn-ghost me-auto" asp-action="Index">Cancelar</a>
                <button class="kt-btn kt-btn-primary" type="submit"><i class="ki-filled ki-check"></i> Salvar</button>
            </div>
        </form>
    </div>
</div>
