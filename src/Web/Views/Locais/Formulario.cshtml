@model LocalRequisicao
@{
    var novo = Model.Id is null;
    ViewData["Title"] = novo ? "Novo local" : $"Editar {Model.Nome}";
    var voltar = Context.Request.Query["voltar"].ToString();
}

<div class="kt-container-fixed">
    <cabecalho-pagina titulo="@(novo ? "Novo local" : Model.Nome)" voltar-href="/Locais" voltar-texto="Locais de treino"
                      descricao="A quadra ou o local onde a turma treina. O endereço vai no aviso às famílias e no link de mapa dos jogos."></cabecalho-pagina>

    <div class="kt-card max-w-[820px]">
        <form asp-action="Salvar" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            @if (Url.IsLocalUrl(voltar))
            {
                <input type="hidden" name="voltar" value="@voltar" />
            }
            <div class="kt-card-content flex flex-col gap-5">
                <partial name="_ErrosFormulario" />
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <div class="flex flex-col gap-1 md:col-span-2">
                        <label class="kt-form-label" asp-for="Nome">Nome</label>
                        <input class="kt-input" asp-for="Nome" required maxlength="100" placeholder="Ex.: Quadra do Colégio Marista" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="Capacidade">Capacidade <span class="text-muted-foreground">(opcional)</span></label>
                        <div class="kt-input-group">
                            <input class="kt-input" asp-for="Capacidade" type="number" min="1" max="100000" />
                            <span class="kt-input-addon">pessoas</span>
                        </div>
                    </div>
                </div>
                <div class="border-t border-border"></div>
                <partial name="_CamposEndereco" model="Model" />
                <div class="flex flex-col gap-1">
                    <label class="kt-form-label" asp-for="Observacao">Como chegar <span class="text-muted-foreground">(opcional)</span></label>
                    <textarea class="kt-textarea" asp-for="Observacao" rows="2" maxlength="300" placeholder="Portão lateral, estacionamento na rua de trás..."></textarea>
                </div>
                <div class="border-t border-border"></div>
                @* P31: a quadra alugada só em certos dias e horários. Treino ou jogo fora deles gera alerta, sem bloquear (R9). *@
                <div class="flex flex-col gap-3" data-esc-linhas data-esc-linhas-prefixo="Horarios">
                    <span class="kt-form-label">Horários disponíveis <span class="text-muted-foreground">(opcional)</span></span>
                    <ul class="flex flex-col gap-3" data-esc-linhas-lista>
                        @for (var i = 0; i < Model.Horarios.Count; i++)
                        {
                            <li class="esc-linha-horario" data-esc-linha>
                                <select class="kt-select" asp-for="Horarios[i].DiaSemana" aria-label="Dia da semana">
                                    @foreach (var dia in DiasSemana.Ordem)
                                    {
                                        <option value="@dia">@DiasSemana.Nome(dia)</option>
                                    }
                                </select>
                                <input class="kt-input" asp-for="Horarios[i].Inicio" type="time" aria-label="Das" />
                                <input class="kt-input" asp-for="Horarios[i].Fim" type="time" aria-label="Até" />
                                <button class="kt-btn kt-btn-icon kt-btn-ghost" type="button" data-esc-linhas-remover hidden aria-label="Retirar horário"><i class="ki-filled ki-trash"></i></button>
                            </li>
                        }
                    </ul>
                    <template data-esc-linhas-modelo>
                        <li class="esc-linha-horario" data-esc-linha>
                            <select class="kt-select" name="Horarios[__i__].DiaSemana" aria-label="Dia da semana">
                                @foreach (var dia in DiasSemana.Ordem)
                                {
                                    <option value="@dia">@DiasSemana.Nome(dia)</option>
                                }
                            </select>
                            <input class="kt-input" name="Horarios[__i__].Inicio" type="time" aria-label="Das" />
                            <input class="kt-input" name="Horarios[__i__].Fim" type="time" aria-label="Até" />
                            <button class="kt-btn kt-btn-icon kt-btn-ghost" type="button" data-esc-linhas-remover aria-label="Retirar horário"><i class="ki-filled ki-trash"></i></button>
                        </li>
                    </template>
                    <div>
                        <button class="kt-btn kt-btn-sm kt-btn-outline" type="button" data-esc-linhas-adicionar hidden><i class="ki-filled ki-plus"></i> Outro horário</button>
                    </div>
                    <p class="text-xs text-muted-foreground">Quando a escolinha pode usar o local (a quadra alugada, por exemplo). Treino ou jogo fora destes horários gera alerta ao salvar. Sem nenhum horário, o local está sempre disponível.</p>
                </div>
            </div>
            <div class="kt-card-footer justify-end gap-2.5">
                <a class="kt-btn kt-btn-ghost me-auto" href="@(Url.IsLocalUrl(voltar) ? voltar : "/Locais")">Cancelar</a>
                <button class="kt-btn kt-btn-primary" type="submit"><i class="ki-filled ki-check"></i> Salvar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/linhas.js" asp-append-version="true"></script>
}
