@model LocalRequisicao
@{
    var novo = Model.Id is null;
    ViewData["Title"] = novo ? "Novo local" : $"Editar {Model.Nome}";
    var voltar = Context.Request.Query["voltar"].ToString();
}

<div class="kt-container-fixed">
    <cabecalho-pagina titulo="@(novo ? "Novo local" : Model.Nome)" voltar-href="/Locais" voltar-texto="Locais de treino"
                      descricao="A quadra ou o local onde a turma treina. O endereço vai no aviso às famílias e no link de mapa dos jogos."></cabecalho-pagina>

    <div class="kt-card max-w-[820px]">
        <form asp-action="Salvar" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            @if (Url.IsLocalUrl(voltar))
            {
                <input type="hidden" name="voltar" value="@voltar" />
            }
            <div class="kt-card-content flex flex-col gap-5">
                <partial name="_ErrosFormulario" />
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <div class="flex flex-col gap-1 md:col-span-2">
                        <label class="kt-form-label" asp-for="Nome">Nome</label>
                        <input class="kt-input" asp-for="Nome" required maxlength="100" placeholder="Ex.: Quadra do Colégio Marista" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="Capacidade">Capacidade <span class="text-muted-foreground">(opcional)</span></label>
                        <div class="kt-input-group">
                            <input class="kt-input" asp-for="Capacidade" type="number" min="1" max="100000" />
                            <span class="kt-input-addon">pessoas</span>
                        </div>
                    </div>
                </div>
                <div class="border-t border-border"></div>
                <partial name="_CamposEndereco" model="Model" />
                <div class="flex flex-col gap-1">
                    <label class="kt-form-label" asp-for="Observacao">Como chegar <span class="text-muted-foreground">(opcional)</span></label>
                    <textarea class="kt-textarea" asp-for="Observacao" rows="2" maxlength="300" placeholder="Portão lateral, estacionamento na rua de trás..."></textarea>
                </div>
            </div>
            <div class="kt-card-footer justify-end gap-2.5">
                <a class="kt-btn kt-btn-ghost me-auto" href="@(Url.IsLocalUrl(voltar) ? voltar : "/Locais")">Cancelar</a>
                <button class="kt-btn kt-btn-primary" type="submit"><i class="ki-filled ki-check"></i> Salvar</button>
            </div>
        </form>
    </div>
</div>
