@model ResponsavelRequisicao
@{
    ViewData["Title"] = $"Editar {Model.Nome}";
}

<div class="kt-container-fixed">
    <cabecalho-pagina titulo="Cadastro do responsável" meta="@Model.Nome" voltar-href="/Responsaveis/Ficha/@Model.Id" voltar-texto="Ficha do responsável"
                      descricao="Vale para todos os filhos. O celular é o WhatsApp da família; o e-mail serve para recuperar o acesso e receber recibo."></cabecalho-pagina>

    <div class="kt-card max-w-[820px]">
        <form asp-action="Editar" asp-route-id="@Model.Id" method="post" novalidate>
            <div class="kt-card-content flex flex-col gap-5">
                <partial name="_ErrosFormulario" />
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="flex flex-col gap-1 md:col-span-2">
                        <label class="kt-form-label" asp-for="Nome">Nome</label>
                        <input class="kt-input" asp-for="Nome" required maxlength="150" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="Telefone">Celular (WhatsApp)</label>
                        <input class="kt-input" asp-for="Telefone" type="tel" inputmode="tel" required />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="kt-form-label" asp-for="Cpf">CPF</label>
                        <input class="kt-input" asp-for="Cpf" inputmode="numeric" placeholder="000.000.000-00" />
                    </div>
                    <div class="flex flex-col gap-1 md:col-span-2">
                        <label class="kt-form-label" asp-for="Email">E-mail <span class="text-muted-foreground">(opcional)</span></label>
                        <input class="kt-input" asp-for="Email" type="email" maxlength="150" />
                    </div>
                </div>
                <div class="border-t border-border"></div>
                <partial name="_CamposEndereco" model="Model" />
            </div>
            <div class="kt-card-footer justify-end gap-2.5">
                <a class="kt-btn kt-btn-ghost me-auto" href="/Responsaveis/Ficha/@Model.Id">Cancelar</a>
                <button class="kt-btn kt-btn-primary" type="submit"><i class="ki-filled ki-check"></i> Salvar</button>
            </div>
        </form>
    </div>
</div>
