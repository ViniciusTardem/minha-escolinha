@model VincularResponsavelRequisicao
@{
    var ficha = (FichaAluno)ViewData["Ficha"]!;
    ViewData["Title"] = $"Adicionar responsável · {ficha.Nome}";
    var escolhidos = ViewData["Escolhidos"] as IReadOnlyDictionary<Guid, ResponsavelEncontrado> ?? new Dictionary<Guid, ResponsavelEncontrado>();
    var duplicidade = ViewData["Duplicidade"] as DuplicidadeResponsavel;
    var pedido = Model.Pedido;
    var dados = new ViewDataDictionary(ViewData)
    {
        ["Indice"] = 0,
        ["Titulo"] = "Responsável",
        ["Escolhido"] = pedido.ResponsavelId is { } rid ? escolhidos.GetValueOrDefault(rid) : null,
        ["Sugestao"] = duplicidade
    };
}

<div class="kt-container-fixed">
    <cabecalho-pagina titulo="Adicionar responsável" meta="@ficha.Nome" voltar-href="/Alunos/Ficha/@ficha.Id?aba=responsaveis" voltar-texto="Ficha do aluno"
                      descricao="Quem já é responsável na escolinha é reaproveitado (busca ou CPF). Marcar outro pagador tira a marca do atual: só um paga."></cabecalho-pagina>

    <div class="kt-card max-w-[900px]">
        <form asp-action="Vincular" method="post" novalidate>
            <input type="hidden" asp-for="AlunoId" />
            <div class="kt-card-content flex flex-col gap-5">
                <partial name="_ErrosFormulario" />
                <partial name="_ResponsavelDoAluno" for="Responsaveis[0]" view-data="dados" />
            </div>
            <div class="kt-card-footer justify-end gap-2.5">
                <a class="kt-btn kt-btn-ghost me-auto" href="/Alunos/Ficha/@ficha.Id?aba=responsaveis">Cancelar</a>
                <button class="kt-btn kt-btn-primary" type="submit"><i class="ki-filled ki-check"></i> Vincular</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/busca-responsavel.js" asp-append-version="true"></script>
}
