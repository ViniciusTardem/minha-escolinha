@{
    var codigo = ViewData["Codigo"] as int? ?? 500;
    ViewData["Title"] = codigo == 404 ? "Página não encontrada" : "Erro";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_LayoutAutenticacao";

    var (icone, titulo, texto) = codigo switch
    {
        404 => ("ki-search-list", "Página não encontrada", "O endereço não existe ou foi removido."),
        403 => ("ki-lock-2", "Acesso negado", "O seu papel não dá acesso a esta área."),
        _ => ("ki-information-2", "Algo deu errado", "O erro foi registrado. Tente de novo; se continuar, avise o suporte informando o código abaixo.")
    };
}

<div class="kt-container-fixed w-full max-w-[640px]">
    <div class="kt-card">
        <div class="kt-card-content flex flex-col items-center justify-center gap-3 py-16 text-center px-5">
            <div class="size-20 rounded-full bg-muted/70 flex items-center justify-center">
                <i class="ki-filled @icone text-4xl text-muted-foreground"></i>
            </div>
            <h1 class="text-base font-semibold text-mono">@titulo</h1>
            <p class="text-sm text-secondary-foreground max-w-sm">@texto</p>
            @if (codigo >= 500)
            {
                <p class="text-xs text-muted-foreground">Código: @ViewData["Rastreio"]</p>
            }
            <a class="kt-btn kt-btn-primary" asp-controller="Painel" asp-action="Index">
                <i class="ki-filled ki-home-2"></i> Ir para o início
            </a>
        </div>
    </div>
</div>
